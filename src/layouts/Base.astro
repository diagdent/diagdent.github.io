---
interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
---

<!doctype html>
<html lang="pl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex" />
    <title>{title}</title>
    <style is:global>
      :root {
        --bg: #f7f8fa;
        --card: #ffffff;
        --text: #1c2430;
        --muted: #64707f;
        --accent: #0e7490;
        --accent-soft: #e0f2f7;
        --border: #e3e7ec;
      }
      @media (prefers-color-scheme: dark) {
        :root {
          --bg: #10151c;
          --card: #171e27;
          --text: #e7ecf2;
          --muted: #93a0b0;
          --accent: #38bdc8;
          --accent-soft: #123a44;
          --border: #263241;
        }
      }
      * {
        box-sizing: border-box;
      }
      body {
        margin: 0;
        background: var(--bg);
        color: var(--text);
        font:
          16px/1.6 -apple-system,
          BlinkMacSystemFont,
          'Segoe UI',
          Roboto,
          sans-serif;
      }
      main {
        max-width: 46rem;
        margin: 0 auto;
        padding: 2rem 1.25rem 4rem;
      }
      header.site {
        margin-bottom: 2.5rem;
      }
      header.site h1 {
        margin: 0 0 0.25rem;
        font-size: 1.75rem;
        letter-spacing: -0.02em;
      }
      header.site p {
        margin: 0;
        color: var(--muted);
      }
      article.release {
        background: var(--card);
        border: 1px solid var(--border);
        border-radius: 12px;
        padding: 1.25rem 1.5rem;
        margin-bottom: 1.5rem;
      }
      article.release header {
        display: flex;
        align-items: baseline;
        gap: 0.75rem;
        flex-wrap: wrap;
        margin-bottom: 0.5rem;
      }
      article.release h2 {
        margin: 0;
        font-size: 1.15rem;
      }
      article.release h2 a {
        color: inherit;
        text-decoration: none;
      }
      time {
        color: var(--muted);
        font-size: 0.875rem;
      }
      ul.entries {
        margin: 0.5rem 0 0;
        padding-left: 1.25rem;
      }
      ul.entries li {
        margin: 0.35rem 0;
      }
      .release-media {
        display: block;
        max-width: 100%;
        margin: 0.6rem 0 0.25rem;
        border: 1px solid var(--border);
        border-radius: 8px;
      }
      .badge {
        display: inline-block;
        font-size: 0.7rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--accent);
        background: var(--accent-soft);
        border-radius: 999px;
        padding: 0.1rem 0.6rem;
      }
      footer.site {
        margin-top: 3rem;
        color: var(--muted);
        font-size: 0.875rem;
      }
      section.product + section.product {
        margin-top: 3rem;
      }
      section.product > h2 {
        font-size: 1.35rem;
        margin: 0 0 1rem;
      }
    </style>
  </head>
  <body>
    <main>
      <slot />
      <footer class="site">DiagDent &middot; historia zmian systemu</footer>
    </main>
    <script is:inline>
      (() => {
        const clips = document.querySelectorAll('video[data-autoplay]');
        if (clips.length === 0) return;
        const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
        const applyReduced = () => {
          for (const clip of clips) {
            clip.pause();
            clip.setAttribute('controls', '');
          }
        };
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              const clip = entry.target;
              if (entry.isIntersecting && !reduced.matches) {
                clip.play().catch(() => {});
              } else {
                clip.pause();
              }
            }
          },
          { threshold: 0.5 },
        );
        reduced.addEventListener('change', () => {
          if (reduced.matches) applyReduced();
        });
        if (reduced.matches) {
          applyReduced();
          return;
        }
        for (const clip of clips) observer.observe(clip);
      })();
    </script>
  </body>
</html>
