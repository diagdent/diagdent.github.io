---
import { getCollection } from 'astro:content';
import Release from '../components/Release.astro';
import Base from '../layouts/Base.astro';
import { newestFirst } from '../newestFirst';

const releases = (await getCollection('releases', ({ data }) => data.product === 'web'))
  .map(({ data }) => ({
    ...data,
    entries: data.entries.filter((entry) => entry.audience === 'doctor'),
  }))
  .filter((release) => release.entries.length > 0)
  .sort(newestFirst);
---

<Base
  title="Portal Lekarza – co nowego?"
  description="Historia zmian Portalu Lekarza"
>
  <header class="site">
    <h1>Co nowego w Portalu Lekarza?</h1>
    <p>Najważniejsze zmiany widoczne dla lekarzy.</p>
  </header>
  {
    releases.map((release) => (
      <Release
        version={release.version}
        date={release.date}
        entries={release.entries}
      />
    ))
  }
</Base>
