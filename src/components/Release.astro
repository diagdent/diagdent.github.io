---
interface Media {
  type: 'image' | 'clip';
  src: string;
  poster?: string;
  alt?: string;
}
interface Entry {
  text: string;
  audience: 'doctor' | 'admin';
  media?: Media;
  spotlight?: { route: string; anchor: string };
}
interface Props {
  version: string;
  date: Date;
  entries: Entry[];
  /** Show per-entry audience badges (admin page only). */
  showAudience?: boolean;
}
const { version, date, entries, showAudience = false } = Astro.props;
const formatted = new Intl.DateTimeFormat('pl-PL', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
}).format(date);
const anchor = `v${version.replaceAll('.', '-')}`;
const clipMime = (src: string) =>
  src.endsWith('.webm')
    ? 'video/webm'
    : src.endsWith('.mp4')
      ? 'video/mp4'
      : undefined;
---

<article class="release" id={anchor}>
  <header>
    <h2><a href={`#${anchor}`}>Wersja {version}</a></h2>
    <time datetime={date.toISOString().slice(0, 10)}>{formatted}</time>
  </header>
  <ul class="entries">
    {
      entries.map((entry) => (
        <li>
          {entry.text}
          {showAudience && entry.audience === 'admin' && (
            <span class="badge">admin</span>
          )}
          {entry.media?.type === 'image' && (
            <img
              class="release-media"
              src={entry.media.src}
              alt={entry.media.alt ?? ''}
              loading="lazy"
              decoding="async"
            />
          )}
          {entry.media?.type === 'clip' && (
            <video
              class="release-clip release-media"
              muted
              loop
              playsinline
              preload="none"
              poster={entry.media.poster}
              data-autoplay
            >
              <source src={entry.media.src} type={clipMime(entry.media.src)} />
            </video>
          )}
        </li>
      ))
    }
  </ul>
</article>
